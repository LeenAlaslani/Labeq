# Public template; never commit real credentials.
LABEQ_TTS_PROVIDER=munsit
LABEQ_VOICE_ENABLED=1
MUNSIT_API_KEY=
MUNSIT_VOICE_ID=
MUNSIT_BASE_URL=https://api.munsit.com/api/v1
MUNSIT_STABILITY=0.44
MUNSIT_SPEED=0.95

# Alternatively use your remote HTTPS Colab / deployed endpoint.
# For local MLX, run `bash prepare_local.sh` (creates keys and fills these).
LABEQ_MODEL_MODE=demo
LABEQ_REQUESTS_PER_MINUTE=30
LABEQ_MODEL_API_URL=
LABEQ_MODEL_API_KEY=

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Separate model service process (CUDA or MLX)
# LABEQ_API_KEY=<same value as LABEQ_MODEL_API_KEY>
# LABEQ_ADAPTER_DIR=/path/to/peft-adapter
# LABEQ_USE_FAISAL=1
# LABEQ_PRELOAD=1
# LABEQ_MLX_ADAPTER_DIR=/path/to/compatible-mlx-or-peft-adapter
# LABEQ_MLX_FAISAL_DIR=/path/to/official-faisal-adapter

# Optional real Ollama writer; Faisal remains a separate MLX routing model.
# LABEQ_WRITER_BACKEND=ollama
# LABEQ_OLLAMA_MODEL=your-installed-model-tag
# LABEQ_OLLAMA_URL=http://127.0.0.1:11434
# LABEQ_WRITER_POLICY=/path/to/a-reviewed-writing-policy.json
